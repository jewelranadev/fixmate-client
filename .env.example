# Backend API URL (Express server)
NEXT_PUBLIC_API_URL=http://localhost:5000

# This app's own URL (Better Auth base URL / trusted origin)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET

# MongoDB (shared with the backend; used by Better Auth)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=fixmate

# ImgBB upload key (server-side route only)
IMGBB_API_KEY=REPLACE_ME

# Stripe keys belong ONLY in fixmate-server/.env. Never add STRIPE_SECRET_KEY
# or STRIPE_WEBHOOK_SECRET here: NEXT_PUBLIC_* values are sent to the browser.
